<script>
const SPOTS = [
  {id:"tunday-kababi-aminabad",name:"Tunday Kababi",area:"Aminabad",lat:26.8437,lng:80.9288,dishes:["Galouti kebab","Paratha","Mutton biryani"],price:"Rs. 150-400",opens:"12:00",closes:"23:00",veg:false},
  {id:"rahims-chowk",name:"Rahim’s Kulche Nihari",area:"Chowk",lat:26.8693,lng:80.9130,dishes:["Nihari","Khameeri roti","Kulche"],price:"Rs. 100-300",opens:"06:00",closes:"11:30",veg:false},
  {id:"idrees-biryani",name:"Idrees Biryani",area:"Nakhas, near Chowk",lat:26.8650,lng:80.9150,dishes:["Chicken biryani","Mutton biryani"],price:"Rs. 150-350",opens:"11:00",closes:"23:00",veg:false},
  {id:"prakash-kulfi-aminabad",name:"Prakash Kulfi",area:"Aminabad",lat:26.8441,lng:80.9293,dishes:["Kulfi falooda","Rabri kulfi"],price:"Rs. 60-200",opens:"11:00",closes:"23:30",veg:true},
  {id:"royal-cafe-hazratganj",name:"Royal Cafe",area:"Hazratganj",lat:26.8500,lng:80.9437,dishes:["Basket chaat","Tikki","Kebab roll"],price:"Rs. 100-300",opens:"11:00",closes:"23:00",veg:true},
  {id:"ram-asrey-sweets",name:"Ram Asrey Sweets",area:"Chowk",lat:26.8680,lng:80.9140,dishes:["Malai gilori","Kachori sabzi","Makhan malai"],price:"Rs. 50-200",opens:"08:00",closes:"21:30",veg:true},
  {id:"late-night-chai-hazratganj",name:"Hazratganj Late Night Chai Stall",area:"Hazratganj",lat:26.8505,lng:80.9445,dishes:["Kulhad chai","Bun maska"],price:"Rs. 20-80",opens:"18:00",closes:"01:00",veg:true}
];

const state = {veg:false, open:false, pos:null, mapOpen:new Set()};
const $ = id => document.getElementById(id);

function mins(t){const [h,m]=t.split(":").map(Number);return h*60+m;}
function isOpen(s, d=new Date()){
  const now=d.getHours()*60+d.getMinutes(), o=mins(s.opens), c=mins(s.closes);
  return o<=c ? (now>=o && now<c) : (now>=o || now<c);   // handles closing after midnight
}
function km(a,b,c,d){
  const R=6371, r=x=>x*Math.PI/180;
  const dLat=r(c-a), dLng=r(d-b);
  const h=Math.sin(dLat/2)**2+Math.cos(r(a))*Math.cos(r(c))*Math.sin(dLng/2)**2;
  return 2*R*Math.asin(Math.sqrt(h));
}
function distText(s){
  if(!state.pos) return s.area;
  const d=km(state.pos.lat,state.pos.lng,s.lat,s.lng);
  return d<1 ? Math.round(d*1000)+" m away" : d.toFixed(1)+" km away";
}
function esc(t){return String(t).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));}

function render(){
  let list = SPOTS.filter(s => (!state.veg||s.veg) && (!state.open||isOpen(s)));
  if(state.pos) list.sort((a,b)=>km(state.pos.lat,state.pos.lng,a.lat,a.lng)-km(state.pos.lat,state.pos.lng,b.lat,b.lng));
  $("status").textContent = list.length+" of "+SPOTS.length+" spots";
  const box=$("spots");
  if(!list.length){box.innerHTML='<div class="empty" style="grid-column:1/-1">No spots match these filters right now.</div>';return;}
  box.innerHTML = list.map(s=>{
    const open=isOpen(s), shown=state.mapOpen.has(s.id), e=0.004;
    const map = shown ? `<iframe title="Map of ${esc(s.name)}" loading="lazy" src="https://www.openstreetmap.org/export/embed.html?bbox=${s.lng-e},${s.lat-e},${s.lng+e},${s.lat+e}&amp;layer=mapnik&amp;marker=${s.lat},${s.lng}"></iframe>` : "";
    return `<article class="card">
      <div class="row"><h3>${esc(s.name)}</h3><span class="badge ${open?"open":"closed"}">${open?"Open":"Closed"}</span></div>
      <div class="meta">${esc(distText(s))} · ${s.opens} - ${s.closes} · ${esc(s.price)}</div>
      <div class="dishes">${s.dishes.map(d=>`<span>${esc(d)}</span>`).join("")}</div>
      ${s.veg?'<div class="meta">Vegetarian options</div>':""}
      ${map}
      <div class="actions">
        <button class="btn ghost small" data-map="${s.id}" aria-expanded="${shown}">${shown?"Hide map":"Show map"}</button>
        <a class="btn small" target="_blank" rel="noopener" href="https://www.google.com/maps/dir/?api=1&destination=${s.lat},${s.lng}&travelmode=walking">Walking directions</a>
      </div>
    </article>`;
  }).join("");
}

$("vegBtn").onclick = e => {state.veg=!state.veg; e.currentTarget.setAttribute("aria-pressed",state.veg); render();};
$("openBtn").onclick = e => {state.open=!state.open; e.currentTarget.setAttribute("aria-pressed",state.open); render();};
$("spots").addEventListener("click", e => {
  const b=e.target.closest("[data-map]"); if(!b) return;
  const id=b.dataset.map;
  state.mapOpen.has(id) ? state.mapOpen.delete(id) : state.mapOpen.add(id);
  render();
});
$("locBtn").onclick = () => {
  const st=$("status");
  if(!navigator.geolocation){st.textContent="Location is not supported on this device.";return;}
  st.textContent="Finding your location…";
  navigator.geolocation.getCurrentPosition(
    p=>{state.pos={lat:p.coords.latitude,lng:p.coords.longitude};render();},
    ()=>{st.textContent="Location was not allowed, so the list is not sorted by distance.";},
    {timeout:10000}
  );
};

// theme toggle (works with the system setting; remembered if storage is available)
(function(){
  const root=document.documentElement;
  try{const t=localStorage.getItem("lb-theme"); if(t) root.setAttribute("data-theme",t);}catch(_){}
  $("themeBtn").onclick=()=>{
    const dark = root.getAttribute("data-theme")==="dark" ||
      (!root.getAttribute("data-theme") && matchMedia("(prefers-color-scheme: dark)").matches);
    const next = dark ? "light" : "dark";
    root.setAttribute("data-theme",next);
    try{localStorage.setItem("lb-theme",next);}catch(_){}
  };
})();

render();
</script>
</body>
</html>
