<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>LucknowBites | Discover the food of Lucknow</title>
<meta name="description" content="LucknowBites is a Flutter app that maps the famous food spots of Lucknow, with dishes, opening hours and walking directions. Try the web demo.">
<meta property="og:title" content="LucknowBites">
<meta property="og:description" content="Discover Lucknow's famous food spots, with directions.">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='22' fill='%232b2f5e'/%3E%3Ctext x='50' y='66' font-size='44' text-anchor='middle' fill='%23fff' font-family='sans-serif' font-weight='700'%3ELB%3C/text%3E%3C/svg%3E">
<style>
:root{
  --bg:#f6f4fb; --surface:#ffffff; --ink:#23264d; --muted:#5f6286; --line:#ddd9ee;
  --brand:#2b2f5e; --brand-ink:#ffffff; --accent:#9a7b3c; --tint:#ece9f8;
  --ok-bg:#dff3e4; --ok-ink:#17602b; --no-bg:#fbe3e3; --no-ink:#8a1f1f;
  color-scheme: light;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#14152b; --surface:#1d1f3b; --ink:#ebeaf7; --muted:#a9abcc; --line:#34375e;
    --brand:#b7b3f0; --brand-ink:#14152b; --accent:#d9c08a; --tint:#272a50;
    --ok-bg:#1e3a29; --ok-ink:#a6e3b8; --no-bg:#432326; --no-ink:#f3b4b4;
    color-scheme: dark;
  }
}
:root[data-theme="dark"]{
  --bg:#14152b; --surface:#1d1f3b; --ink:#ebeaf7; --muted:#a9abcc; --line:#34375e;
  --brand:#b7b3f0; --brand-ink:#14152b; --accent:#d9c08a; --tint:#272a50;
  --ok-bg:#1e3a29; --ok-ink:#a6e3b8; --no-bg:#432326; --no-ink:#f3b4b4;
  color-scheme: dark;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:72px}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.6 system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif}
a{color:inherit}
.wrap{max-width:1040px;margin:0 auto;padding:0 20px}
header.nav{position:sticky;top:0;z-index:10;background:var(--bg);border-bottom:1px solid var(--line)}
.nav .wrap{display:flex;align-items:center;justify-content:space-between;height:56px}
.logo{display:flex;align-items:center;gap:10px;font-weight:700;text-decoration:none}
.logo span{display:grid;place-items:center;width:30px;height:30px;border-radius:8px;background:var(--brand);color:var(--brand-ink);font-size:13px}
.nav nav{display:flex;gap:18px;align-items:center}
.nav nav a{text-decoration:none;color:var(--muted);font-size:14px}
.nav nav a:hover{color:var(--ink)}
@media(max-width:620px){.nav nav a.hide-sm{display:none}}
button{font:inherit;cursor:pointer}
.btn{display:inline-flex;align-items:center;gap:8px;border-radius:10px;padding:10px 18px;font-weight:600;font-size:15px;text-decoration:none;border:1.5px solid var(--brand);background:var(--brand);color:var(--brand-ink)}
.btn.ghost{background:transparent;color:var(--ink)}
.btn.small{padding:6px 12px;font-size:13px;border-radius:8px}
.hero{padding:64px 0 48px}
.hero .grid{display:grid;grid-template-columns:1.1fr .9fr;gap:40px;align-items:center}
@media(max-width:800px){.hero .grid{grid-template-columns:1fr}}
.eyebrow{color:var(--accent);font-weight:700;font-size:13px;letter-spacing:.08em;text-transform:uppercase}
h1{font-size:clamp(36px,6vw,56px);line-height:1.1;margin:8px 0 16px;letter-spacing:-.02em}
.lead{font-size:18px;color:var(--muted);max-width:34em}
.cta{display:flex;gap:12px;flex-wrap:wrap;margin-top:24px}
.phone{justify-self:center;width:250px;border:8px solid var(--brand);border-radius:34px;background:var(--surface);padding:14px 12px;box-shadow:0 20px 40px rgba(35,38,77,.18)}
.phone .bar{font-weight:700;font-size:14px;margin-bottom:8px}
.phone .chips{display:flex;gap:6px;margin-bottom:8px}
.phone .chip{font-size:11px;padding:3px 9px;border-radius:99px;background:var(--tint)}
.phone .mini{border:1px solid var(--line);border-radius:10px;padding:8px 10px;margin-bottom:8px;font-size:12px}
.phone .mini b{display:block;font-size:13px}
.phone .mini small{color:var(--muted)}
section{padding:56px 0;border-top:1px solid var(--line)}
h2{font-size:30px;margin:0 0 6px;letter-spacing:-.01em}
.sub{color:var(--muted);margin:0 0 28px}
/* demo */
.controls{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-bottom:18px}
.chipbtn{border:1.5px solid var(--line);background:var(--surface);color:var(--ink);padding:7px 14px;border-radius:99px;font-size:14px}
.chipbtn[aria-pressed="true"]{background:var(--brand);color:var(--brand-ink);border-color:var(--brand)}
.status{color:var(--muted);font-size:14px;margin-left:auto}
.spots{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:16px}
.card{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:16px;display:flex;flex-direction:column;gap:8px}
.card h3{margin:0;font-size:18px}
.row{display:flex;justify-content:space-between;gap:10px;align-items:flex-start}
.badge{font-size:12px;font-weight:700;padding:2px 10px;border-radius:99px;white-space:nowrap}
.badge.open{background:var(--ok-bg);color:var(--ok-ink)}
.badge.closed{background:var(--no-bg);color:var(--no-ink)}
.meta{color:var(--muted);font-size:14px}
.dishes{display:flex;flex-wrap:wrap;gap:6px}
.dishes span{background:var(--tint);padding:2px 10px;border-radius:99px;font-size:13px}
.actions{display:flex;gap:8px;margin-top:auto;padding-top:6px}
.card iframe{width:100%;height:200px;border:0;border-radius:10px;margin-top:4px}
.empty{padding:30px;text-align:center;color:var(--muted);border:1px dashed var(--line);border-radius:14px}
.note{font-size:13px;color:var(--muted);margin-top:16px}
/* steps / tech */
.steps{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px;counter-reset:s}
.step{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:18px}
.step::before{counter-increment:s;content:counter(s);display:grid;place-items:center;width:28px;height:28px;border-radius:50%;background:var(--brand);color:var(--brand-ink);font-weight:700;font-size:14px;margin-bottom:10px}
.step h3{margin:0 0 4px;font-size:17px}
.step p{margin:0;color:var(--muted);font-size:15px}
.tech{display:flex;flex-wrap:wrap;gap:10px}
.tech span{border:1.5px solid var(--line);background:var(--surface);padding:6px 14px;border-radius:10px;font-weight:600;font-size:14px}
.two{display:grid;grid-template-columns:1fr 1fr;gap:32px}
@media(max-width:800px){.two{grid-template-columns:1fr}}
.panel{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:20px}
.panel h3{margin-top:0}
ul.clean{padding-left:20px;margin:0}
ul.clean li{margin:6px 0}
pre{margin:0;overflow-x:auto;background:var(--tint);border-radius:10px;padding:14px;font:13px/1.6 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace}
footer{border-top:1px solid var(--line);padding:28px 0;color:var(--muted);font-size:14px}
footer .wrap{display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px}
.skip{position:absolute;left:-999px}
.skip:focus{left:10px;top:10px;background:var(--surface);padding:8px;z-index:20}
:focus-visible{outline:3px solid var(--accent);outline-offset:2px}
</style>
</head>
