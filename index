<main id="top">
<section class="hero" style="border-top:0">
  <div class="wrap grid">
    <div>
      <div class="eyebrow">Flutter app · Personal project</div>
      <h1>Find Lucknow’s best food, lane by lane.</h1>
      <p class="lead">LucknowBites maps the kebab stalls, chaat corners and sweet shops of the old city. See what to order, when each place opens and how to walk there.</p>
      <div class="cta">
        <a class="btn" href="#demo">Try the demo</a>
        <a class="btn ghost" href="#run">Run the app</a>
      </div>
    </div>
    <div class="phone" aria-hidden="true">
